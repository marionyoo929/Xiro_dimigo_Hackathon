{
  "name": "dimigo-hackathon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node scripts/verify-place-search.mjs && node scripts/verify-registered-catalog.mjs && node scripts/verify-client-random.mjs && node --test server/test/*.test.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "test:e2e": "playwright test",
    "generate:types": "node scripts/generate-api-types.mjs",
    "create:user": "node --env-file-if-exists=.env.local scripts/create-user.mjs",
    "backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "catalog:replace": "node --env-file-if-exists=.env.local scripts/replace-demo-catalog.mjs",
    "stats:seed": "node scripts/seed-statistics.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.3.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
